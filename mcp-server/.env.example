# Required: Comma-separated list of directories containing git repos to index
SOURCE_DIRS=/Users/<user>/Documents/visual-studio-code/github-copilot,/Users/<user>/Documents/visual-studio-code/antigravity-and-others

# Required: Path to the wiki directory
WIKI_DIR=/Users/<user>/Documents/visual-studio-code/github-copilot/code-wiki/wiki

# GitHub sync (optional but recommended)
GITHUB_USERNAME=mindfu23
GITHUB_TOKEN=ghp_xxxxx

# Tuning (optional)
SYNC_INTERVAL_MINUTES=60
MAX_SEARCH_RESULTS=50
WIKI_BOOST_MULTIPLIER=2.0
CACHE_MAX_AGE_MINUTES=60
INDEX_ON_STARTUP=true
