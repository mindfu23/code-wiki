# Required: Comma-separated list of directories containing git repos to index
SOURCE_DIRS=/path/to/your/workspace,/path/to/another/workspace

# Required: Path to the wiki directory (typically the wiki/ folder of this repo)
WIKI_DIR=/path/to/code-wiki/wiki
# Optional: local clone of your private content repo's wiki/ (default: <WIKI_DIR>/../private-content/wiki if it exists)
# PRIVATE_WIKI_DIR=/path/to/code-wiki/private-content/wiki
# Optional: fast-forward that clone on startup so nightly status pages are current
# PRIVATE_WIKI_AUTO_PULL=true

# GitHub sync (optional but recommended)
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=ghp_xxxxx

# Tuning (optional)
SYNC_INTERVAL_MINUTES=60
MAX_SEARCH_RESULTS=50
WIKI_BOOST_MULTIPLIER=2.0
CACHE_MAX_AGE_MINUTES=60
INDEX_ON_STARTUP=true
