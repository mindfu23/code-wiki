{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist",
    "noEmit": true
  },
  "include": ["src/**/*", "netlify/functions/_shared/**/*"],
  "exclude": ["node_modules", "dist", "netlify/functions-dist", "netlify/functions/*.ts"]
}
